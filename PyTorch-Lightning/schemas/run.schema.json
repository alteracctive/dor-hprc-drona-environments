      "batchSize": {
        "type": "number",
        "label": "Batch size",
        "name": "batchSize",
        "value": "32"
      },
      "learningRate": {
        "type": "text",
        "label": "Learning rate",
        "name": "learningRate",
        "value": "1e-3",
        "placeholder": "e.g. 0.001 or 1e-3",
        "help": "Decimal or scientific notation only (e.g. 0.001, 1e-3). Invalid values are rejected when the job script is generated."
      },
      "numWorkers": {
        "type": "number",
        "label": "DataLoader workers",
        "name": "numWorkers",
        "value": "0",
        "help": "Number of DataLoader subprocesses. Use 0 on single-CPU allocations to avoid worker overhead."
      },
      "seed": {
        "type": "number",
        "label": "Random seed",
        "name": "seed",
        "value": "42",
        "help": "Seed for PyTorch Lightning and dataset randomness. Default is 42."
      },
      "precision": {
        "type": "select",
        "label": "Training precision",
        "name": "precision",
        "value": "tf32",
        "help": "Controls numeric precision and Tensor Core use. TF32 keeps float32 Trainer precision but calls torch.set_float32_matmul_precision('high') for faster matmuls on H100/A30. BF16 mixed enables Lightning automatic mixed precision (precision='bf16-mixed') for additional speedup. FP32 disables Tensor Core TF32 (highest precision, slower).",
        "options": [
          {
            "label": "TF32 (recommended for H100/A30 Tensor Cores)",
            "value": "tf32"
          },
          {
            "label": "BF16 mixed precision (precision='bf16-mixed')",
            "value": "bf16-mixed"
          },
          {
            "label": "FP16 mixed precision (precision='16-mixed')",
            "value": "16-mixed"
          },
          {
            "label": "FP32 full precision (no TF32)",
            "value": "32"
          }
        ]
      }
    }
  },
  "ContainerLogging": {
    "type": "rowContainer",
    "label": "Logging",
    "elements": {
      "logDir": {
        "type": "picker",
        "label": "Log directory",
        "name": "logDir",
        "localLabel": "Location",
        "showFiles": "False",
        "files": "False",
        "defaultLocation": "./lightning_logs",
        "defaultPaths": {
          "HOME": "$HOME",
          "SCRATCH": "/scratch/user/$USER"
        },
        "useHPCDefaultPaths": "False",
        "help": "Directory where Lightning TensorBoard/CSV logs and checkpoints are written. Defaults to ./lightning_logs relative to the job staging directory."
      },
      "logEveryNSteps": {
        "type": "number",
        "label": "Log every N steps",
        "name": "logEveryNSteps",
        "value": "50"
      },
      "checkpointEnable": {
        "type": "checkbox",
        "label": "Enable model checkpointing",
        "name": "checkpointEnable",
        "value": "Yes",
        "help": "When enabled, saves the best-performing model checkpoint based on minimum validation loss. When disabled, defaults to saving only the final model state at the last epoch."
      },
      "exportOnnx": {
        "type": "checkbox",
        "label": "Export final model to ONNX",
        "name": "exportOnnx",
        "value": "No",
        "condition": "!modelCategory.gnn",
        "help": "When enabled, exports the trained model to ONNX format (final_model.onnx) at the end of the training run."
      }
    }
  },
  "ContainerTasks": {
    "type": "rowContainer",
    "label": "GPU",
    "elements": {
      "cpus": {
        "type": "number",
        "label": "#CPUs/task",
        "name": "cpus",
        "value": "1",
        "max": "96"
      },
      "gpuDropdown": {
        "type": "dynamicSelect",
        "label": "Use Accelerator",
        "name": "gpu",
        "value": "",
        "help": "Optional. Defaults to CPU (no accelerator). Select a GPU only if your training will use it.",
        "retrieverParams": {
          "MODEL_CATEGORY": "$modelCategory"
        },
        "retriever": "retrieve_gpus"
      },
      "numgpus": {
        "type": "number",
        "label": "#GPUs",
        "name": "numgpu",
        "value": "1",
        "condition": " !gpu.none && !gpu. "
      }
    }
  },
  "ContainerAdditionals": {
    "type": "rowContainer",
    "label": "Slurm Options",
    "elements": {
      "memory": {
        "type": "unit",
        "label": "Memory",
        "name": "memory",
        "units": [
          {
            "label": "GB",
            "value": "G"
          }
        ]
      },
      "Walltime": {
        "type": "time",
        "label": "Expected run time",
        "name": "walltime",
        "value": ""
      },
      "account": {
        "type": "dynamicSelect",
        "label": "Project Account",
        "name": "account",
        "retriever": "list_accounts"
      },
      "extraText": {
        "type": "text",
        "label": "Additional Slurm parameters",
        "name": "extra_slurm",
        "value": ""
      }
    }
  }
}