    "customJobName": "",
    "pickerLabel": "Location",
    "showName": true,
    "showLocation": true,
    "disableJobNameChange": false,
    "disableJobLocationChange": false
  },
  "ContainerModelCategory": {
    "type": "rowContainer",
    "label": "Model Type",
    "elements": {
      "modelCategory": {
        "type": "select",
        "name": "modelCategory",
        "label": "Model category",
        "help": "Select the model category template. Choose Custom to start with a barebone template",
        "options": [
          {
            "label": "Custom (Bare-bones template)",
            "value": "custom"
          },
          {
            "label": "Computer Vision (Classification, segmentation, ViT) - .png, .jpg, .jpeg, .bmp, .webp",
            "value": "computer_vision"
          },
          {
            "label": "Sequential / Time-Series (LSTMs, GRUs, 1D CNNs, Transformers)- .csv",
            "value": "sequential"
          },
          {
            "label": "Natural Language Processing (Native Torchtext/PyTorch)- .csv, .tsv, .txt",
            "value": "nlp"
          },
          {
            "label": "Tabular & Structured Data Deep Learning - .csv",
            "value": "tabular"
          },
          {
            "label": "Audio & Signal Processing - .wav, .mp3, .flac, .ogg",
            "value": "audio"
          },
          {
            "label": "Generative Models (VAEs, GANs, Diffusion) - .png, .jpg, .jpeg, .bmp, .webp",
            "value": "generative"
          },
          {
            "label": "Graph Neural Networks (GNN) - .graph, .edgelist",
            "value": "gnn"
          }
        ],
        "value": "custom"
      }
    }
  },
  "ContainerCVDataset": {
    "type": "rowContainer",
    "label": "Image Dataset",
    "condition": "modelCategory.computer_vision",
    "elements": {
      "datasetType": {
        "type": "radioGroup",
        "name": "datasetType",
        "label": "Dataset source",
        "options": [
          {
            "label": "Import",
            "value": "custom"
          },
          {
            "label": "Prepared",
            "value": "builtin"
          }
        ],
        "value": "custom"
      },
      "builtinDatasetRow": {
        "type": "rowContainer",
        "label": "",
        "condition": "datasetType.builtin",
        "elements": {
          "builtinDataset": {
            "type": "select",
            "label": "Prepared dataset",
            "name": "builtinDataset",
            "value": "ImageNet",
            "help": "Cluster dataset modules are loaded directly from cluster storage. Direct internet downloads are disabled. For other datasets, choose Import to provide your data path.",
            "options": [
              {
                "value": "ImageNet",
                "label": "ImageNet (HPRC Datasets/ImageNet-PyTorch)"
              }
            ]
          }
        }
      },
      "customDataPath": {
        "type": "picker",
        "label": "Custom data directory",
        "name": "customDataPath",
        "remoteLabel": "local",
        "localLabel": "cluster",
        "showFiles": "False",
        "help": "Path to dataset root with train/, val/, and optionally test/ subdirectories. For classification (CNN, MLP, ViT), each class must be a subfolder containing raw image files (.png, .jpg, .jpeg, .bmp, .webp) or .pt tensors. For U-Net segmentation, requires images/ and masks/ subdirectories with matching image files (.png, .jpg, .jpeg, .bmp, .webp) or .pt tensors.",
        "condition": "datasetType.custom",
        "files": "False"
      },
      "cvModelArch": {
        "type": "select",
        "label": "Model architecture",
        "name": "cvModelArch",
        "value": "cnn",
        "options": [
          {
            "value": "cnn",
            "label": "CNN Classification"
          },
          {
            "value": "mlp",
            "label": "MLP Classification"
          },
          {
            "value": "vit",
            "label": "Vision Transformer (ViT)"
          },
          {
            "value": "unet",
            "label": "U-Net Semantic Segmentation"
          }
        ],
        "condition": "datasetType.custom",
        "help": "Select model architecture for your custom image dataset (accepts .png, .jpg, .jpeg, .bmp, .webp raw images or .pt tensor files)."
      },
      "cvDatasetFormat": {
        "type": "radioGroup",
        "label": "Dataset format",
        "name": "cvDatasetFormat",
        "value": "tensors",
        "options": [
          {
            "label": "Raw Images (.png, .jpg, etc.)",
            "value": "images"
          },
          {
            "label": "PyTorch Tensors (.pt)",
            "value": "tensors"
          }
        ],
        "condition": "datasetType.custom",
        "help": "Choose whether your custom data folder contains raw images (.png, .jpg, .jpeg, .bmp, .webp organized by class subdirectories, or images/masks subdirectories for UNet) or pre-processed PyTorch tensor (.pt) files."
      }
    }
  },
  "ContainerCVSettings": {
    "type": "rowContainer",
