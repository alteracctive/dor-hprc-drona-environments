{
  "runDestinationFinal": {
    "type": "jobNameLocation",
    "label": "Job Name and Location",
    "help": "Optional. Leave blank to use defaults. If empty, the engine will assign a job ID and staging path automatically. Spaces in the job name are converted to underscores.",
    "customJobName": "",
    "pickerLabel": "Location",
    "showName": true,
    "showLocation": true,
    "disableJobNameChange": false,
    "disableJobLocationChange": false
  },

  "ContainerModelCategory": {
    "type": "rowContainer",
    "label": "Model Type",
    "elements": {
      "modelCategory": {
        "type": "select",
        "name": "modelCategory",
        "label": "Model category",
        "help": "Select the model category:\\n- Custom: A bare-bones, highly commented blueprint for any user model.\\n- Computer Vision: Classification, segmentation (UNet), and ViT architectures.\\n- Sequential: Time-series forecasting and classification with LSTMs, GRUs, 1D CNNs, and Transformers.\\n- Natural Language Processing (Native Torchtext/PyTorch): Sequence-to-sequence, text classification, and custom lightweight Attention/Transformer blocks without overhead.\\n- Tabular & Structured Data Deep Learning: DeepMLPs, ResNets for Tabular, or TabNet primitives.\\n- Audio & Signal Processing: Speech processing, acoustic classification, and waveform synthesis using native torchaudio transforms.\\n- Generative Models: Image generation and latent space learning with VAEs, GANs, and Diffusion models.\\n- Graph Neural Networks (GNN): Node classification and molecular property regression (QM9) using GCN, GAT, or GraphSAGE message passing.",
        "options": [
          { "label": "Custom (Bare-bones blueprint)", "value": "custom" },
          { "label": "Computer Vision (Classification, segmentation, ViT)", "value": "computer_vision" },
          { "label": "Sequential / Time-Series (LSTMs, GRUs, 1D CNNs, Transformers)", "value": "sequential" },
          { "label": "Natural Language Processing (Native Torchtext/PyTorch)", "value": "nlp" },
          { "label": "Tabular & Structured Data Deep Learning", "value": "tabular" },
          { "label": "Audio & Signal Processing", "value": "audio" },
          { "label": "Generative Models (VAEs, GANs, Diffusion)", "value": "generative" },
          { "label": "Graph Neural Networks (GNN)", "value": "gnn" }
        ],
        "value": "custom"
      }
    }
  },

  "ContainerCVDataset": {
    "type": "rowContainer",
    "label": "Image Dataset",
    "condition": "modelCategory.computer_vision",
    "elements": {
      "datasetType": {
        "type": "radioGroup",
        "name": "datasetType",
        "label": "Dataset source",
        "options": [
          { "label": "Import", "value": "custom" },
          { "label": "Prepared", "value": "builtin" }
        ],
        "value": "custom"
      },
      "builtinDatasetRow": {
        "type": "rowContainer",
        "label": "",
        "condition": "datasetType.builtin",
        "elements": {
          "builtinDataset": {
            "type": "select",
            "label": "Prepared dataset",
            "name": "builtinDataset",
            "value": "ImageNet",
            "help": "Cluster dataset modules are loaded directly; prepared benchmarks are fetched automatically on the submit node.",
            "options": [
              { "value": "ImageNet", "label": "ImageNet (HPRC Datasets/ImageNet-PyTorch)" }
            ]
          }
        }
      },
      "customDataPath": {
        "type": "picker",
        "label": "Custom data directory",
        "name": "customDataPath",
        "remoteLabel": "local",
        "localLabel": "cluster",
        "showFiles": "False",
        "help": "Path to dataset root with train/, val/, and optionally test/ subdirectories. Each class must be a subfolder (class name) containing standard raw images (.png, .jpg, .jpeg) corresponding to that class.",
        "condition": "datasetType.custom",
        "files": "False"
      },
      "cvModelArch": {
        "type": "select",
        "label": "Model architecture",
        "name": "cvModelArch",
        "value": "cnn",
        "options": [
          { "value": "cnn", "label": "CNN Classification" },
          { "value": "mlp", "label": "MLP Classification" },
          { "value": "vit", "label": "Vision Transformer (ViT)" },
          { "value": "unet", "label": "U-Net Semantic Segmentation" }
        ],
        "condition": "datasetType.custom",
        "help": "Select model architecture for your custom image dataset."
      },
      "cvDatasetFormat": {
        "type": "radioGroup",
        "label": "Dataset format",
        "name": "cvDatasetFormat",
        "value": "tensors",
        "options": [
          { "label": "Raw Images (.png, .jpg, etc.)", "value": "images" },
          { "label": "PyTorch Tensors (.pt)", "value": "tensors" }
        ],
        "condition": "datasetType.custom",
        "help": "Choose whether your custom data folder contains raw images (organized by class subdirectories, or image/mask subdirectories for UNet) or pre-processed PyTorch tensor (.pt) files."
      }
    }
  },

